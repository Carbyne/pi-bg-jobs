    "name": "Carbyne",
    "email": "15847393+Carbyne@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Carbyne/pi-bg-jobs.git"
  },
  "homepage": "https://github.com/Carbyne/pi-bg-jobs#readme",
  "bugs": {
    "url": "https://github.com/Carbyne/pi-bg-jobs/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "check:runtime": "node --experimental-strip-types --input-type=module -e \"await import('./extensions/bg-jobs/index.ts')\""
