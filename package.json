  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "^25.9.5",
    "typebox": "1.3.7",
    "typescript": "^5.9.0"
  },
  "pi": {
    "extensions": [
      "./extensions/bg-jobs/index.ts"
    ]
  }
}
